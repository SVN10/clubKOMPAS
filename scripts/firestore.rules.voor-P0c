// Firestore-regels zoals ze in de console stonden vóór P0c (veiliggesteld op 19 november 2026).
// Terugdraaien: plak deze tekst in de console (Firestore Database → Regels) en publiceer.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /clubs/{clubId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == clubId;
    }
  }
}
