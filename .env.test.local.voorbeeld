# VOORBEELD — VUL DIT BESTAND NOOIT IN. Het gaat mee in git en moet leeg blijven.
#
# Kopieer het naar .env.test.local (in de terminal: cp .env.test.local.voorbeeld .env.test.local)
# en vul alléén die kopie met de zes waarden uit de Firebase-console
# (testproject svn10-clubkompas-test → Projectinstellingen → Je apps → clubKOMPAS test → firebaseConfig).
# Alle zes waarden zijn verplicht. Zet nooit de waarden van svn10-clubkompas in .env.test.local.
# Scripts en npm run regels:* stoppen als dit voorbeeldbestand toch is ingevuld.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Lokaal toont de app altijd "Ontwikkel" (npm run dev); dit label geldt alleen voor een lokale build.
VITE_OMGEVING=Ontwikkel
